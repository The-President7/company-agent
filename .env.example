# Neon Postgres connection string. Use the pooled URL and require TLS.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Single workspace configured for this app instance.
COMPANY_WORKSPACE_ID=the-president
COMPANY_WORKSPACE_NAME=The President

# Audit identity labels only; these do not authenticate users.
APP_USER_ID=local-admin
APP_USER_NAME=Local admin

# Set false when connecting a real database without synthetic sample events.
SEED_DEMO_DATA=false

# Generate a long random token and protect all administrative API routes with it.
API_AUTH_TOKEN=replace-with-a-long-random-secret

# OpenAI-compatible model API. Compatible gateways can be used via LLM_BASE_URL.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Slack history access: grant only the required conversations.history scopes.
SLACK_BOT_TOKEN=
# GitHub read-only token and explicit owner/repo allowlist.
GITHUB_TOKEN=
GITHUB_REPOSITORIES=owner/repository

# WhatsApp Cloud API webhook configuration. Use PUBLIC_BASE_URL/webhooks/whatsapp.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Comma-separated authorized WhatsApp Business phone-number IDs.
WHATSAPP_PHONE_NUMBER_IDS=
PUBLIC_BASE_URL=https://your-domain.example

# Optional alert destination receives a message when an issue reaches this count.
ALERT_WEBHOOK_URL=
ALERT_THRESHOLD=10

# Comma-separated origins allowed to send browser SDK requests; * allows any origin.
MONITOR_ALLOWED_ORIGINS=*
